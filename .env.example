# Copiar a .env y completar valores reales
#
# Conexión: o bien DATABASE_URL, o bien DB_HOST + DB_PORT + DB_USER + DB_PASS + DB_NAME
# (recomendado si la contraseña tiene caracteres especiales).
# DATABASE_URL="mysql://user:pass@host:3306/dbname"
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASS=
# DB_NAME=
#
# Tienda monomarca: evita queries a BD en cada request (middleware, checkout, jobs).
# EMPRESA_ID=1
#
# Pool (hosting compartido suele limitar conexiones/hora): menos connectionLimit = menos conexiones simultáneas.
# DB_POOL_LIMIT=5
# DB_ACQUIRE_TIMEOUT=30000
# DB_CONNECT_TIMEOUT=15000
# DB_POOL_IDLE_TIMEOUT_SEC=1800
# Escrituras paralelas en sync (default: DB_POOL_LIMIT - 1)
# DB_WRITE_CONCURRENCY=4
#
# Jobs de checkout (reintentos SFactory, vencimiento): en desarrollo están off salvo PEDIDO_CHECKOUT_JOBS_ENABLED=true
# PEDIDO_CHECKOUT_JOBS_ENABLED=true

PORT=3003
NODE_ENV=development

# Mantenimiento: off | public (tienda) | admin (panel) | all
# Misma variable en client/.env.local — ver api/docs/maintenance.md
MAINTENANCE_MODE=off

SFACTORY_API_URL="https://sfactory-api.com.ar/sfactory/api"
SFACTORY_USERDEV=""
SFACTORY_PASSWORD=""
SFACTORY_USER_FACTORY=""
SFACTORY_PASSWORD_FACTORY=""
SFACTORY_COMPANY_KEY=""

# ID del depósito ECOMMERCE en S-Factory (stock/precios vía inventario)
SFACTORY_WAREHOUSE_ID_ECOM=52624

# SFactory — pedido externo (ventas_crear_pedido_externo). Debe existir en external_orders_config.
SFACTORY_PEDIDO_EXTERNO_SOURCE=ecommerce
SFACTORY_ENTREGA_PROVINCIA_DEFAULT=Cordoba
SFACTORY_ENTREGA_LOCALIDAD_DEFAULT=Córdoba Capital

# Reintentos si falla la creación en SFactory (pedido-checkout jobs)
# SFACTORY_PEDIDO_MAX_REINTENTOS=3

# DEPRECADO para el flujo web — era de ventas_crear_orden_pedido (orden interna legacy):
# SFACTORY_ORDEN_MONEDA_ID=1
# SFACTORY_ORDEN_COTIZACION=1
# SFACTORY_ORDEN_SUCURSAL_ID=1
# SFACTORY_ORDEN_LISTA_PRECIO_ID=1
# SFACTORY_RESERVA_DEPOSITO_ID=1
# SFACTORY_ENTREGA_CLIENTE_DIR_ID=1
# SFACTORY_ENTREGA_LOCALIDAD_ID=1

# true = tras /sync/productos y /sync/all también ejecuta sync de stock/precios del depósito
# SYNC_STOCK_AFTER_PRODUCTOS=false

# Envíos (defaults al crear EmpresaEnvioConfig; entorno runtime = INTEGRATIONS_ENV)
# INTEGRATIONS_ENV=test
# SHIPPING_DEFAULT_PROVIDER=andreani
#
# MiCorreo — credenciales por INTEGRATIONS_ENV (test → *_QA, production → *_PROD)
# CORREO_USERNAME_QA=
# CORREO_PASSWORD_QA=
# CORREO_USERNAME_PROD=
# CORREO_PASSWORD_PROD=
# CORREO_USERNAME=
# CORREO_PASSWORD=
# CORREO_ORIGIN_CP=5000
# CORREO_ORIGIN_PROVINCE_CODE=X
# Email del portal MiCorreo para POST /users/validate (si CORREO_USERNAME_* no es un mail, obligatorio)
# CORREO_EMAIL_QA=
# CORREO_EMAIL_PROD=
# CORREO_EMAIL=
# Opcional: saltar validate y usar id conocido (solo pruebas)
# CORREO_CUSTOMER_ID=
# CORREO_MOCK=false
# CORREO_TIMEOUT_MS=30000
#
# Andreani — test → ANDREANI_*_QA, prod → ANDREANI_*_PROD (o ANDREANI_USERNAME/PASSWORD)
# ANDREANI_USERNAME_QA=
# ANDREANI_PASSWORD_QA=
# ANDREANI_USERNAME_PROD=
# ANDREANI_PASSWORD_PROD=
# ANDREANI_USERNAME=
# ANDREANI_PASSWORD=
# ANDREANI_CLIENTE=
# ANDREANI_CONTRATO_DOM=
# ANDREANI_CONTRATO_SUC=
# ANDREANI_SUCURSAL_CLIENTE_ID=0
# ANDREANI_PATH_AGENCIAS=/v1/sucursales
# ANDREANI_ORIGEN_CP=
# ANDREANI_ORIGEN_CALLE=
# ANDREANI_ORIGEN_NUMERO=
# ANDREANI_ORIGEN_LOCALIDAD=
# ANDREANI_ORIGEN_REGION=
# ANDREANI_REMITENTE_NOMBRE=
# ANDREANI_REMITENTE_EMAIL=
# ANDREANI_REMITENTE_TELEFONO=

# Checkout Mercado Pago (ngrok sin barra final; empresa monotienda)
# NGROK_URL=https://xxxx.ngrok-free.dev
# EMPRESA_ID=1
# URL pública del front (Next) para back_urls del checkout MP — sin barra final
# Ej.: http://localhost:3002  o  https://tutienda.com
# CHECKOUT_PUBLIC_URL=http://localhost:3002
#
# Mercado Pago — modo según INTEGRATIONS_ENV (ver api/docs/integrations-env.md)
# test → MERCADOPAGO_ACCESS_TOKEN_TEST / _QA
# production → MERCADOPAGO_ACCESS_TOKEN_PROD / MERCADOPAGO_ACCESS_TOKEN
# MERCADOPAGO_ACCESS_TOKEN_TEST=
# MERCADOPAGO_ACCESS_TOKEN_QA=
# MERCADOPAGO_ACCESS_TOKEN_PROD=
# MERCADOPAGO_ACCESS_TOKEN=
# Plazo (minutos) para cancelar pedidos MP sin pago (default 30). Requiere jobs activos.
# CHECKOUT_MP_EXPIRES_MINUTES=30
# MP_RECONCILE_INTERVAL_MS=300000
# PEDIDO_CHECKOUT_JOBS_ENABLED=true

# —— Resend (emails transaccionales / marketing) ——
# RESEND_API_KEY=
# RESEND_FROM_TRANSACTIONAL="Natural Design <pedidos@mail.naturalonline.com.ar>"
# RESEND_FROM_MARKETING="Natural Design <novedades@naturalonline.com.ar>"
# RESEND_INTERNAL_TO=rovalencia@naturalonline.com.ar
# Opcional: copia interna de formulario contacto (por defecto ventas@naturalonline.com.ar)
# RESEND_CONTACT_INTERNAL_TO=ventas@naturalonline.com.ar
# Logo en emails (URL pública)
# BRAND_LOGO_URL=https://naturalonline.com.ar/logos/logo-2.svg
# BRAND_WHATSAPP_DIGITS=5493517136311
# URL base del frontend para link de unsubscribe
# NEWSLETTER_UNSUBSCRIBE_BASE_URL=https://naturalonline.com.ar
# Dirección punto de retiro en tienda (emails de confirmación / listo para retirar)
# STORE_PICKUP_ADDRESS=Alta Córdoba, Córdoba Capital.
# URLs públicas de seguimiento (opcional; {trackingNumber} se reemplaza al crear envío)
# ANDREANI_TRACKING_URL=https://www.andreani.com/#!/informacionEnvio/{trackingNumber}
# CORREO_TRACKING_URL=https://www.correoargentino.com.ar/formularios/ccu/consulta-envio?id={trackingNumber}
# Tope de destinatarios por campaña (plan Resend gratis ≈ 100/día)
# NEWSLETTER_MAX_RECIPIENTS=100

# Webhook ERP → actualiza estadoErp y envía email al cliente (header x-api-key)
# ERP_ORDER_STATUS_SECRET=

# QA: permitir cualquier dominio en registro/login (test@example.com)
# ALLOW_ANY_EMAIL_DOMAIN=true